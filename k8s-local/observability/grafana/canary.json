{
  "uid": "canary-deployment",
  "title": "Canary Deployment",
  "tags": [
    "canary",
    "rollouts"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "svc",
        "label": "Service",
        "type": "custom",
        "query": "order-api : order, auth-api : auth, catalog-api : catalog",
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "order-api",
          "value": "order"
        },
        "options": []
      },
      {
        "name": "rs",
        "label": "ReplicaSet",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_request_duration_seconds_count{service=\"$svc\"}, service_instance_id)",
        "regex": "/($svc-[^-]+)-[^-]+$/",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Traffic share · $rs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service=\"$svc\", service_instance_id=~\"$rs-.*\"}[1m])) / scalar(sum(rate(http_server_request_duration_seconds_count{service=\"$svc\"}[1m])))",
          "legendFormat": "$rs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Total request rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service=\"$svc\"}[1m]))",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Error rate · $rs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{service=\"$svc\", service_instance_id=~\"$rs-.*\", http_response_status_code=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{service=\"$svc\", service_instance_id=~\"$rs-.*\"}[1m]))",
          "legendFormat": "$rs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Request share by ReplicaSet",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rs) (label_replace(rate(http_server_request_duration_seconds_count{service=\"$svc\"}[1m]), \"rs\", \"$1\", \"service_instance_id\", \"($svc-[^-]+)-.*\"))",
          "legendFormat": "{{rs}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": {
              "mode": "percent",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "ReplicaSets serving traffic",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (rs) (label_replace(rate(http_server_request_duration_seconds_count{service=\"$svc\"}[1m]), \"rs\", \"$1\", \"service_instance_id\", \"($svc-[^-]+)-.*\"))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "count by (rs) (label_replace(sum by (service_instance_id) (rate(http_server_request_duration_seconds_count{service=\"$svc\"}[1m])), \"rs\", \"$1\", \"service_instance_id\", \"($svc-[^-]+)-.*\"))"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "rs",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "rs": "ReplicaSet",
              "Value #A": "req/s",
              "Value #B": "pods"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "req/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pods"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "title": "Payments by method",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (rs, payment_method) (label_replace(increase(payment_requests_total{service=\"$svc\", payment_status=\"paid\"}[$__range]), \"rs\", \"$1\", \"service_instance_id\", \"($svc-[^-]+)-.*\"))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (rs, payment_method) (label_replace(increase(payment_requests_total{service=\"$svc\", payment_status=\"failed\"}[$__range]), \"rs\", \"$1\", \"service_instance_id\", \"($svc-[^-]+)-.*\"))"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "sum by (rs, payment_method) (label_replace(increase(payment_requests_total{service=\"$svc\", payment_status=\"failed\"}[$__range]), \"rs\", \"$1\", \"service_instance_id\", \"($svc-[^-]+)-.*\")) / sum by (rs, payment_method) (label_replace(increase(payment_requests_total{service=\"$svc\"}[$__range]), \"rs\", \"$1\", \"service_instance_id\", \"($svc-[^-]+)-.*\"))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "rs": "ReplicaSet",
              "payment_method": "Method",
              "Value #A": "paid",
              "Value #B": "failed",
              "Value #C": "fail %"
            },
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fail %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.05
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "ReplicaSet",
            "desc": true
          }
        ]
      }
    }
  ]
}
